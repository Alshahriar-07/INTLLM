# INTLLM backend configuration
# Copy to `.env` and adjust. Never commit a populated .env or real secrets.

# --- Application -----------------------------------------------------------
INTLLM_ENV=development
# Bind address for the FastAPI server. Localhost by default (PLAN security rule).
INTLLM_HOST=127.0.0.1
# Valid TCP port range is 0-65535. The PLAN default is 8000.
INTLLM_PORT=8000
INTLLM_LOG_LEVEL=INFO
INTLLM_API_PREFIX=/api
INTLLM_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Reject request bodies larger than this many bytes (default 10 MiB).
INTLLM_MAX_REQUEST_BYTES=10485760

# --- Local OpenAI-compatible API access ------------------------------------
# local = bind the loopback interface only (default, safest).
# lan   = bind the LAN interface; /v1 becomes reachable from the same network
#         and still requires an API key. Internal /api routes stay loopback-only.
INTLLM_API_ACCESS_MODE=local
# Interface used when LAN access is enabled (all interfaces by default).
INTLLM_API_LAN_HOST=0.0.0.0

# --- INTLLM runtime endpoint (this server's actual listening address) --------
# This is the REAL address the backend binds to and the frontend connects to.
# The old values (host=172.22.0.1, port=240426) were incorrect: 240426 is not
# a valid TCP port and 172.22.0.1 is not loopback. Use 127.0.0.1 for local services.
INTLLM_RUNTIME_HOST=127.0.0.1
INTLLM_RUNTIME_PORT=8000
INTLLM_RUNTIME_BASE_URL=http://127.0.0.1:8000

# --- PostgreSQL ------------------------------------------------------------
# asyncpg URL used by the app AND by Alembic (backend/migrations/env.py uses the
# async engine). Never commit a real password.
INTLLM_DATABASE_URL=postgresql+asyncpg://intllm:intllm@127.0.0.1:5432/intllm
# Retained for tooling that prefers a sync driver; not required by the app.
INTLLM_DATABASE_URL_SYNC=postgresql+psycopg://intllm:intllm@127.0.0.1:5432/intllm
# Bounded connect/command timeout (seconds) so a down server cannot hang startup.
INTLLM_DB_CONNECT_TIMEOUT_SECONDS=5
# On a fresh install the configured database may not exist yet. When enabled,
# INTLLM creates the *missing* database (CREATE DATABASE only; never DROP).
INTLLM_DB_AUTO_CREATE=true

# --- Ollama ----------------------------------------------------------------
INTLLM_OLLAMA_URL=http://127.0.0.1:11434
INTLLM_OLLAMA_TIMEOUT_SECONDS=120
INTLLM_DEFAULT_MODEL=

# --- Data / workspace ------------------------------------------------------
INTLLM_DATA_DIR=./data
INTLLM_WORKSPACE_DIR=./workspace
# Comma-separated allow-list of directories the filesystem tools may touch.
INTLLM_FILESYSTEM_ALLOWLIST=./workspace

# --- Web retrieval ---------------------------------------------------------
# Provider: `duckduckgo` (real, no key) or `searxng` (point at a real instance).
INTLLM_WEB_PROVIDER=duckduckgo
INTLLM_WEB_SEARXNG_URL=
INTLLM_WEB_TIMEOUT_SECONDS=15
INTLLM_WEB_MAX_RESULTS=8

# --- Browser ---------------------------------------------------------------
INTLLM_BROWSER_ENABLED=true
INTLLM_BROWSER_HEADLESS=true
INTLLM_BROWSER_TIMEOUT_SECONDS=30

# --- Background learning ---------------------------------------------------
INTLLM_MAX_BACKGROUND_WORKERS=1
INTLLM_BACKGROUND_POLL_SECONDS=5
# Interactive latency above this threshold throttles background work.
INTLLM_BACKGROUND_LATENCY_THRESHOLD_MS=1500
INTLLM_BACKGROUND_CPU_THRESHOLD_PERCENT=85
INTLLM_BACKGROUND_RAM_THRESHOLD_PERCENT=90
