# INTLLM backend configuration
# Copy to `.env` and adjust. Never commit a populated .env or real secrets.

# --- Application -----------------------------------------------------------
INTLLM_ENV=development
# Bind address for the FastAPI server. Localhost by default (PLAN security rule).
INTLLM_HOST=127.0.0.1
# Valid TCP port range is 0-65535. The PLAN default is 8000.
INTLLM_PORT=8000
INTLLM_LOG_LEVEL=INFO
INTLLM_API_PREFIX=/api
INTLLM_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- INTLLM runtime endpoint (frontend/back-end advertised address) --------
# The project owner supplied the following runtime address:
#     INTLLM HOST: 172.22.0.1
#     SUPPLIED PORT: 240426
#     STATUS: REQUIRES PORT VALIDATION
# 240426 is NOT a valid TCP/UDP port (valid range 0-65535) and MUST NOT be
# bound or dialed. The backend does not silently substitute a port; the real
# listening port must be confirmed before this value is used.
INTLLM_RUNTIME_HOST=172.22.0.1
INTLLM_RUNTIME_PORT=
INTLLM_RUNTIME_BASE_URL=
INTLLM_RUNTIME_PORT_SUPPLIED=240426
INTLLM_RUNTIME_PORT_STATUS=requires_validation

# --- PostgreSQL ------------------------------------------------------------
INTLLM_DATABASE_URL=postgresql+asyncpg://intllm:intllm@127.0.0.1:5432/intllm
# Alembic runs migrations with the sync driver by default.
INTLLM_DATABASE_URL_SYNC=postgresql+psycopg://intllm:intllm@127.0.0.1:5432/intllm

# --- Ollama ----------------------------------------------------------------
INTLLM_OLLAMA_URL=http://127.0.0.1:11434
INTLLM_OLLAMA_TIMEOUT_SECONDS=120
INTLLM_DEFAULT_MODEL=

# --- Data / workspace ------------------------------------------------------
INTLLM_DATA_DIR=./data
INTLLM_WORKSPACE_DIR=./workspace
# Comma-separated allow-list of directories the filesystem tools may touch.
INTLLM_FILESYSTEM_ALLOWLIST=./workspace

# --- Web retrieval ---------------------------------------------------------
# Provider: `duckduckgo` (real, no key) or `searxng` (point at a real instance).
INTLLM_WEB_PROVIDER=duckduckgo
INTLLM_WEB_SEARXNG_URL=
INTLLM_WEB_TIMEOUT_SECONDS=15
INTLLM_WEB_MAX_RESULTS=8

# --- Browser ---------------------------------------------------------------
INTLLM_BROWSER_ENABLED=true
INTLLM_BROWSER_HEADLESS=true
INTLLM_BROWSER_TIMEOUT_SECONDS=30

# --- Background learning ---------------------------------------------------
INTLLM_MAX_BACKGROUND_WORKERS=1
INTLLM_BACKGROUND_POLL_SECONDS=5
# Interactive latency above this threshold throttles background work.
INTLLM_BACKGROUND_LATENCY_THRESHOLD_MS=1500
INTLLM_BACKGROUND_CPU_THRESHOLD_PERCENT=85
INTLLM_BACKGROUND_RAM_THRESHOLD_PERCENT=90
