# INTLLM frontend configuration
# Copy to `.env` (Vite only exposes variables prefixed with VITE_).

# Preferred: full backend base URL (no trailing slash).
VITE_INTLLM_BASE_URL=http://127.0.0.1:8000

# Fallback used when VITE_INTLLM_BASE_URL is empty.
# INTLLM_PORT must be a valid TCP port (1-65535). The project owner supplied
# 240426, which is NOT a valid network port and must not be used here. The real
# listening port must be confirmed with the backend before connection.
VITE_INTLLM_HOST=127.0.0.1
VITE_INTLLM_PORT=8000

# Health + Ollama polling interval in ms (clamped 5000-60000, default 8000).
# Polling pauses automatically while the tab is hidden.
#VITE_INTLLM_POLLING_INTERVAL_MS=8000

# Backend request timeout in ms (clamped 2000-60000, default 15000).
#VITE_INTLLM_CONNECTION_TIMEOUT_MS=15000

# --- Ollama -----------------------------------------------------------------
# The Ollama endpoint shown in the UI comes from the backend
# (GET /api/ollama/status); the backend's INTLLM_OLLAMA_URL is authoritative.
# Display default when the backend is unreachable:
# http://127.0.0.1:11434


